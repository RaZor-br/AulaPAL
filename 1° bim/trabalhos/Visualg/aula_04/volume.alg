algoritmo "cilindro"
// Função :
// Autor :    Pedro Antonio
// Data : 18/03/2026
// Seção de Declarações 
var
   VL, RAIO, AL:real
inicio
escreva("digite o numero do raio: ")
leia(RAIO)
escreva("digite o numero da altura: ")
leia(AL)
VL<-3.14159*RAIO*RAIO*AL
escreva("O volume é: ", VL, "m")
fimalgoritmo
