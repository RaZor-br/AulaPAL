algoritmo "estoque mercado"
// Função :
// Autor :    Pedro Antonio
// Data : 18/03/2026
// Seção de Declarações 
var
QC, QM, QE:real
inicio
// Seção de Comandos 
escreva("digite a quantidade maxima: ")
leia(QM)
escreva("quantidade em estoque: ")
leia(QE)
QC<-QM-QE
escreva("quantidade a comprar: ", QC)
fimalgoritmo
