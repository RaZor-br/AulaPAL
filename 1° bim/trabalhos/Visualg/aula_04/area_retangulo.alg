algoritmo "peso e nome 2 pessoas"
// Função :
// Autor :
// Data : 25/03/2026
// Seção de Declarações
var
A, B, AE, PE:real
inicio
escreva("digite o valor do lado A do retangulo: ")
leia(A)
escreva("digite o valor do lado B do retangulo: ")
leia(B)
AE<-A*B
PE<-2*A+2*B
escrevaL("a area do retangulo é:", AE)
escreva("o perimetro do retangulo é:", PE)








fimalgoritmo
