algoritmo "dias vividos"
// Função :
// Autor :      Pedro Antonio de Oliveira Alves
// Data : 11/03/2026
// Seção de Declarações 
var
    D_V, ID:real
    N:caracter
inicio
escreva("Digite a sua idade: ")
leia(ID)
escreva("digite seu nome: ")
leia(N)
D_V<-ID*365
escreva(N, " viveu ", D_V, " dias")
fimalgoritmo
