algoritmo "quatro operações"
// Função :
// Autor :      Pedro Antonio de Oliveira Alves
// Data : 11/03/2026
// Seção de Declarações 
var
     num1, num2, mul, divi, sub, adi : real
inicio
escreva("digite o primeiro numero ")
leia(num1)
escreva("digite o segundo numero ")
leia(num2)
mul <- num1 * num2
divi <- num1 / num2
sub <- num1 - num2
adi <- num1 + num2
escreval("o resultado da multiplicação é: ", mul)
escreval("o resultado da divisão é: ", divi)
escreval("o resultado da adição é: ", adi)
escreva("o resultado da subtração é: ", sub)
fimalgoritmo
