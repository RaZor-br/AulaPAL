algoritmo "se positivo, metade, se negativo, ao quadrado"
// Função :
// Autor :
// Data : 25/03/2026
// Seção de Declarações
var
PSH, PSM, PS, ALT:real
GN: caracter
inicio
escreva("digite seu peso: ")
leia(PS)
escreva("digite sua altura: ")
leia(ALT)
escreva("digite seu sexo(M/F): ")
leia(GN)
se(GN = "m") ou (GN = "M")entao

fimalgoritmo
