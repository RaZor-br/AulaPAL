algoritmo "salario + reajuste"
// Função :
// Autor :      Pedro Antonio de Oliveira Alves
// Data : 11/03/2026
// Seção de Declarações 
var
   SL, P, SLP:real

inicio
escreva("Digite o salario inicial: ")
leia(SL)
SLP<-SL+(SL*25)/100
escreva("Seu salario reajustado é de", SLP, " Reais(R$)")
fimalgoritmo
