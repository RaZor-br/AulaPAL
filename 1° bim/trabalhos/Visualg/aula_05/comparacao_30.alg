algoritmo "comparacao com 30"
// Função :
// Autor :
// Data : 25/03/2026
// Seção de Declarações 
var
N1, N2, NF:real
inicio
// Seção de Comandos 
escreva("digite o primeiro numero: ")
leia(N1)
escreva("digite o segundo numero: ")
leia(N2)
NF <- N1+N2
se(NF >= 30)entao
      se(NF = 30)entao
            escreva("o numero é 30")
      senao
            escreva("o numero é maior do que 30")
      fimse
senao
      escreva("o numero é menor do que 30")
fimse


fimalgoritmo
