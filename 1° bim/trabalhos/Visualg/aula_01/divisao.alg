algoritmo "aula_01"
// Função :
// Autor : Pedro Antonio
// Data : 04/03/2026
// Seção de Declarações
var
   divisao,numero1,numero2: real
inicio
escreva("digite o primeiro numero: ")
leia(numero1)
escreva("digite o segundo numero: ")
leia(numero2)
divisao <- numero1 / numero2
escreva("o resultado da equação é: ", divisao)

fimalgoritmo

