algoritmo "aula_01"
// Função :
// Autor : Pedro Antonio
// Data : 04/03/2026
// Seção de Declarações
var
   nome: caracter
   idade: caracter
inicio
escreva("digite seu nome: ")
leia(nome)
escreva("digite sua idade: ")
leia(idade)
escreval("seu nome é: " , nome)
escreva("sua idade é: " , idade)

fimalgoritmo

