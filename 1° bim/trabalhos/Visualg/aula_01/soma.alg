algoritmo "aula_01"
// Função :
// Autor : Pedro Antonio
// Data : 04/03/2026
// Seção de Declarações
var
   soma,numero1,numero2: inteiro
inicio
escreva("digite o primeiro numero: ")
leia(numero1)
escreva("digite o segundo numero: ")
leia(numero2)
soma <- numero1 + numero2
escreva("o resultado da soma é: ", soma)

fimalgoritmo

