algoritmo "dobro e triplo de numeros"
// Função :
// Autor :
// Data : 04/03/2026
// Seção de Declarações 
var
   numero1, numero2, dobro, triplo: inteiro
inicio
escreva("digite o primeio numero: ")
leia(numero1)
escreva("digite o segundo numero: ")
leia(numero2)
dobro <- numero1 * 2
triplo <- numero2 * 3
escreval("resultado do primeiro numero: " , dobro)
escreva("resultado do segundo numero: " , triplo)
fimalgoritmo

